# =============================================================================
# MK6 Client Hub — Variáveis de ambiente para rodar 100% local
# =============================================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commit .env.local no Git — ele já está no .gitignore por padrão.
# =============================================================================

# ---------------------------------------------------------------------------
# CLIENTE (Vite) — já vêm preenchidas no .env gerado pelo Lovable Cloud
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://wbfjsyxfaimivhzfxtxo.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=wbfjsyxfaimivhzfxtxo

# ---------------------------------------------------------------------------
# SERVIDOR (Cloudflare Worker) — necessárias para server functions e webhooks
# ---------------------------------------------------------------------------

# URL do Supabase (igual ao VITE_*, mas lido no servidor)
SUPABASE_URL=https://wbfjsyxfaimivhzfxtxo.supabase.co

# Publishable key do Supabase (usada em SSR e server functions)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service Role Key — BYPASSA RLS. Use APENAS em código server-side.
# Pegue em: Project Settings → API → service_role key (revelar secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Connection String do Postgres (para psql, migrações ad-hoc etc.)
# Pegue em: Project Settings → Database → Connection String (URI)
SUPABASE_DB_URL=postgresql://postgres:[password]@db.wbfjsyxfaimivhzfxtxo.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# INTEGRAÇÕES EXTERNAS
# ---------------------------------------------------------------------------

# Notion API Key — necessária para sincronização de clientes e financeiro
# Crie em: https://www.notion.so/my-integrations → New integration
NOTION_API_KEY=secret_...

# Webhook Secret para validação HMAC do /api/public/hooks/nps
# Defina um valor aleatório forte (mín. 32 caracteres)
NPS_WEBHOOK_SECRET=whsec_sua_chave_secreta_aqui_min_32_chars

# Lovable AI Gateway Key — para resumos de NPS, AI features etc.
# Provisionada automaticamente pelo Lovable Cloud. Não crie manualmente.
# Se faltar, peça para rodar no Lovable Cloud ou use o preview online.
LOVABLE_API_KEY=lov_...

# =============================================================================
# COMO OBTER OS SEGREDOS DO LOVABLE CLOUD:
# =============================================================================
# 1. Abra o projeto no editor Lovable
# 2. Vá em: Configurações do Projeto → Secrets / Variáveis de Ambiente
# 3. Copie os valores de SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL,
#    NOTION_API_KEY, NPS_WEBHOOK_SECRET e LOVABLE_API_KEY
# 4. Cole neste arquivo renomeado para .env.local
#
# ⚠️ Atenção:
# - A NOTION_API_KEY é gerenciada pelo connector; só pode ser editada
#   via Connectors no painel Lovable, não via secrets tools.
# - LOVABLE_API_KEY é auto-provisionada; nunca a crie manualmente.
# - SUPABASE_SERVICE_ROLE_KEY dá acesso total ao banco. Nunca exponha no frontend.
#
# Para rodar SEM as integrações (apenas UI + auth básico):
# Basta preencher as VITE_* e SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY.
# As funções server que usam Notion, AI ou webhooks retornarão erro,
# mas o frontend carrega normalmente.
# =============================================================================
